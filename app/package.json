{
  "name": "daybook-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "build": {
    "appId": "app.daybook.mac",
    "productName": "Daybook",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../runner/daybook",
        "to": "runner/daybook",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../LAWS.md",
        "to": "runner/daybook/LAWS.md"
      },
      {
        "from": "build/python-${arch}/python",
        "to": "python"
      }
    ],
    "protocols": [
      {
        "name": "Daybook sign-in",
        "schemes": [
          "daybook"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Daybook"
    }
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "app:start": "electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "python:fetch": "node scripts/fetch-python.mjs",
    "dist:mac": "npm run build && node scripts/fetch-python.mjs arm64 && electron-builder --mac"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^9.1.0"
  }
}
