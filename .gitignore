# --- Secrets and local state -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs --------------------------------------------------------------------
*.log
logs/

# --- App data (never in the repo; SQLite, locks and logs live here) ----------
appdata/
*.sqlite
*.sqlite3
*.db

# --- Anything that could hold a real person's folder -------------------------
# The ONLY state folder in this repo is fixtures/sample-folder. Everything else
# that looks like one is assumed to be real and is refused. See CLAUDE.md rule 1.
/secretary/
/Secretary/
/*-folder/
scratch/
tmp/
# NOTE: these patterns are anchored to the repo root on purpose, so that
# fixtures/sample-folder/ is never caught and never needs a "!" re-include.
# Git cannot re-include a file whose parent directory is excluded, so a
# negation here would be load-bearing and would fail silently.

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---------------------------------------------------------
node_modules/
app/dist/
app/.vite/
*.tsbuildinfo

# --- macOS -------------------------------------------------------------------
.DS_Store
.AppleDouble

# --- Editors -----------------------------------------------------------------
.idea/
*.swp

# --- Unrelated local tooling -------------------------------------------------
.qodo/
.vscode/
briefs/*.html
!fixtures/sample-folder/briefs/README.md
.zcode/
